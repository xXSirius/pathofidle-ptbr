---
// Header do projeto: esconde ao rolar pra baixo, reaparece ao rolar pra
// cima, destaca o link da seção visível, e usa o MobileMenu (island) no
// mobile. Nenhum link aponta para "#" — todos vão pra uma seção real.
import { Image } from 'astro:assets';
import MobileMenu from '../islands/MobileMenu.tsx';
import wordmark from '../../assets/logo/wordmark.png';

const links = [
  { label: 'Sobre', href: '#sobre' },
  { label: 'Screenshots', href: '#screenshots' },
  { label: 'Changelog', href: '#changelog' },
  { label: 'Instalação', href: '#instalacao' },
  { label: 'Contribuir', href: '#contribuir' },
];

const RELEASES_URL = 'https://github.com/xXSirius/pathofidle-ptbr/releases/latest';
---

<header id="site-header" class="fixed top-0 inset-x-0 z-40 transition-transform duration-300 border-b border-transparent">
  <div class="container-wide flex items-center justify-between h-20">
    <a href="#top" class="flex items-center gap-3">
      <Image src={wordmark} alt="Path of Idle" class="h-8 w-auto" widths={[400, 700, 1100]} sizes="260px" format="png" />
      <small class="font-sans italic text-sm text-text-soft border-l border-border pl-3">tradução pt&#8209;br</small>
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Menu principal">
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-link font-serif text-sm uppercase tracking-[0.12em] text-text-soft hover:text-secondary transition-colors"
          data-nav-link
        >
          {link.label}
        </a>
      ))}
      <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="btn-primary !py-2.5 !px-5 text-sm">
        Baixar
      </a>
    </nav>

    <MobileMenu client:load links={links} ctaLabel="Baixar a Tradução" ctaHref={RELEASES_URL} />
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;

    var lastY = window.scrollY;
    var ticking = false;

    function onScroll() {
      var y = window.scrollY;
      header.classList.toggle('bg-background/90', y > 40);
      header.classList.toggle('backdrop-blur-md', y > 40);
      header.classList.toggle('border-border', y > 40);
      header.classList.toggle('is-solid', y > 40);

      if (y > lastY && y > 160) {
        header.style.transform = 'translateY(-100%)';
      } else {
        header.style.transform = 'translateY(0)';
      }
      lastY = y;
      ticking = false;
    }

    document.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
    onScroll();

    // destaca o link da seção visível
    var navLinks = Array.prototype.slice.call(document.querySelectorAll('[data-nav-link]'));
    var sections = navLinks
      .map(function (a) { return document.querySelector(a.getAttribute('href')); })
      .filter(Boolean);

    if ('IntersectionObserver' in window && sections.length) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var link = navLinks[sections.indexOf(entry.target)];
            if (!link) return;
            if (entry.isIntersecting) {
              navLinks.forEach(function (l) { l.classList.remove('text-secondary'); });
              link.classList.add('text-secondary');
            }
          });
        },
        { rootMargin: '-40% 0px -50% 0px' }
      );
      sections.forEach(function (s) { observer.observe(s); });
    }
  })();
</script>
