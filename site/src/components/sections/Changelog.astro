---
const REPO = 'xXSirius/pathofidle-ptbr';
const CHANGELOG_URL = `https://raw.githubusercontent.com/${REPO}/master/CHANGELOG.md`;
const HISTORY_URL = `https://github.com/${REPO}/commits/master/CHANGELOG.md`;
---

<section id="changelog" class="section-py bg-background">
  <div class="container-wide">
    <div class="text-center mb-16">
      <span class="label-tag block mb-3">Sempre atualizando</span>
      <h2 class="section-plaque" data-animate>O Que Mudou</h2>
      <p class="text-body-lg text-text-soft max-w-2xl mx-auto mt-6" data-animate>
        O jogo recebe atualização, a tradução acompanha. Veja aqui quando sai versão nova, sem
        precisar ficar checando fórum ou Discord.
      </p>
    </div>

    <div
      class="cut-corners bg-surface border border-secondary/60 max-w-3xl mx-auto flex flex-wrap items-center justify-between gap-4 px-8 py-5 mb-16"
      data-animate
    >
      <span id="version-tag" class="font-serif text-secondary border border-border px-4 py-2 text-sm">carregando…</span>
      <p class="text-body-sm text-text-soft flex-1 min-w-[200px]">
        Dados puxados direto do <code class="text-secondary">CHANGELOG.md</code> do repositório.
      </p>
      <a href={HISTORY_URL} target="_blank" rel="noopener noreferrer" class="link-underline text-label text-secondary whitespace-nowrap">
        Histórico completo →
      </a>
    </div>

    <div id="changelog-list" class="max-w-3xl mx-auto" data-animate>
      <p class="text-center text-text-muted italic">Carregando changelog…</p>
    </div>

    <div class="text-center mt-14" data-animate>
      <p class="text-body-md text-text-soft mb-5 max-w-md mx-auto">
        Atualizar é o mesmo processo de instalar: baixe o pacote mais recente e rode o
        instalador de novo, que substitui os arquivos antigos sozinho.
      </p>
      <a href="https://github.com/xXSirius/pathofidle-ptbr/releases" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        Baixar Última Versão
      </a>
    </div>
  </div>
</section>

<script define:vars={{ CHANGELOG_URL }} is:inline>
  (function () {
    var listEl = document.getElementById('changelog-list');
    var versionTag = document.getElementById('version-tag');
    var statVersion = document.getElementById('statVersion');
    if (!listEl) return;

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function inline(str) {
      return escapeHtml(str)
        .replace(/`([^`]+)`/g, '<code class="text-secondary">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    }

    function parseChangelog(md) {
      var chunks = md.split(/\n##\s+/).slice(1);
      return chunks.map(function (chunk) {
        var lines = chunk.split('\n');
        var heading = lines.shift().trim();
        var parts = heading.split(/\s+—\s+/);
        var version = parts[0].trim();
        var date = parts[1] ? parts[1].trim() : '';

        var summaryLines = [];
        var items = [];
        lines.forEach(function (line) {
          var trimmed = line.trim();
          if (!trimmed) return;
          if (trimmed.indexOf('- ') === 0) {
            items.push(trimmed.slice(2));
          } else if (items.length) {
            items[items.length - 1] += ' ' + trimmed;
          } else {
            summaryLines.push(trimmed);
          }
        });

        return { version: version, date: date, summary: summaryLines.join(' '), items: items };
      });
    }

    function render(entries) {
      if (!entries.length) {
        listEl.innerHTML = '<p class="text-center text-text-muted italic">Nenhuma entrada encontrada.</p>';
        return;
      }
      versionTag.textContent = 'v' + entries[0].version;
      if (statVersion) statVersion.textContent = 'v' + entries[0].version;

      var html = entries.slice(0, 6).map(function (entry) {
        var items = entry.items.map(function (i) { return '<li class="mb-1.5">' + inline(i) + '</li>'; }).join('');
        return (
          '<div class="relative border-l-2 border-border pl-7 pb-9 last:pb-0">' +
          '<span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-background border-2 border-secondary"></span>' +
          '<span class="font-serif text-text-main text-lg uppercase">v' + inline(entry.version) + '</span>' +
          '<span class="text-text-muted text-sm italic ml-2">' + escapeHtml(entry.date) + '</span>' +
          (entry.summary ? '<p class="text-text-soft my-2">' + inline(entry.summary) + '</p>' : '') +
          (items ? '<ul class="list-disc pl-5 text-text-soft text-body-sm">' + items + '</ul>' : '') +
          '</div>'
        );
      }).join('');
      listEl.innerHTML = html;
    }

    function showFallback() {
      listEl.innerHTML =
        '<p class="text-center text-text-muted italic">Não deu para carregar o changelog agora. ' +
        '<a class="link-underline text-secondary" href="https://github.com/xXSirius/pathofidle-ptbr/blob/master/CHANGELOG.md" target="_blank" rel="noopener">Veja direto no GitHub</a>.</p>';
      versionTag.textContent = 'ver no GitHub';
    }

    // raw.githubusercontent.com às vezes trava sem responder (sem erro HTTP,
    // sem rejeitar a promise) em vez de falhar rápido — sem esse timeout a
    // tela fica presa em "Carregando…" pra sempre em vez de cair no fallback.
    var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
    var timeoutId = setTimeout(function () {
      if (controller) controller.abort();
    }, 8000);

    fetch(CHANGELOG_URL, controller ? { signal: controller.signal } : undefined)
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.text();
      })
      .then(function (md) {
        clearTimeout(timeoutId);
        render(parseChangelog(md));
      })
      .catch(function () {
        clearTimeout(timeoutId);
        showFallback();
      });
  })();
</script>
