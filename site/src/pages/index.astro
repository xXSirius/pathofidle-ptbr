---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import StatsBar from '../components/sections/StatsBar.astro';
import About from '../components/sections/About.astro';
import Gallery from '../components/sections/Gallery.astro';
import Changelog from '../components/sections/Changelog.astro';
import Install from '../components/sections/Install.astro';
import Contribute from '../components/sections/Contribute.astro';
import Support from '../components/sections/Support.astro';
import GuidePromo from '../components/sections/GuidePromo.astro';
---

<BaseLayout>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <StatsBar />
    <About />
    <Gallery />
    <Changelog />
    <Install />
    <Contribute />
    <Support />
    <GuidePromo />
  </main>

  <Footer />
</BaseLayout>
