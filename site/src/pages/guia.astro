      <tbody>
        <tr><td><b>Guerreiro</b></td><td>Martelo + Espada</td><td>Placa</td><td class="num">50–60</td><td class="num">40–50</td><td>Mais resistente — o da frente</td></tr>
        <tr><td><b>Caçador</b></td><td>Arco + Adaga</td><td>Couro</td><td class="num">45–55</td><td class="num">45–55</td><td>Esquiva, feras e execução</td></tr>
        <tr><td><b>Mago</b></td><td>Cajado + Tomo</td><td>Tecido</td><td class="num">40–50</td><td class="num">50–60</td><td>Maior teto de dano, mais frágil</td></tr>
        <tr><td><b>Clérigo</b></td><td>Martelo + Cajado</td><td>Placa</td><td class="num">45–55</td><td class="num">45–55</td><td>Resistente, com auras e cura</td></tr>
