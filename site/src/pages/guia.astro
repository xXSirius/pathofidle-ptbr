</style>

<script is:inline>

  var links = {};
  [].forEach.call(document.querySelectorAll('nav.toc a'), function (a) {
    links[a.getAttribute('href').slice(1)] = a;
  });
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var a = links[e.target.id];
        if (a && e.isIntersecting) {
          for (var k in links) links[k].classList.remove('on');
          a.classList.add('on');
        }
      });
    }, { rootMargin: '-10% 0px -80% 0px' });
    [].forEach.call(document.querySelectorAll('main section'), function (s) { if (s.id) io.observe(s); });
  }

  var q = document.getElementById('q');
  var btns = [].slice.call(document.querySelectorAll('button.f'));
  var rows = [].slice.call(document.querySelectorAll('#blist .bd'));
  var nores = document.getElementById('nores');
  var mode = 'all';
  function apply() {
    var term = (q.value || '').toLowerCase().trim();
    var shown = 0;
    rows.forEach(function (r) {
      var vis = (mode === 'all' || r.dataset.d === mode) &&
                (!term || r.textContent.toLowerCase().indexOf(term) !== -1);
      r.hidden = !vis;
      if (vis) shown++;
    });
    nores.hidden = shown !== 0;
  }
  q.addEventListener('input', apply);
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      mode = b.dataset.f;
      btns.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
      apply();
    });
  });

</script>
